pkgtype(kind: "executable")

supported_targets = "+native"

import {
  "moonsage/ai",
  "moonsage/runtime",
  "moonsage/project",
  "moonsage/protocol",
  "moonsage/research",
  "moonsage/types",
  "moonsage/search",
  "moonsage/chat",
  "moonsage/tui",
  "moonsage/mooncakes",
  "moonsage/md_ansi",
  "moonsage/tools",
  "moonsage/audit",
  "moonsage/batch",
  "moonsage/editing",
  "moonsage/util",
  "moonsage/dotenv",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/x/sys",
}

options(
  "native-stub": [ "windows_argv.c", "console_utf8.c" ],
)
