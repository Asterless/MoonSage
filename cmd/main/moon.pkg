pkgtype(kind: "executable")

supported_targets = "+native"

import {
  "moonsage/llm",
  "moonsage",
  "moonsage/chat",
  "moonsage/tui",
  "moonsage/mooncakes",
  "moonsage/md_ansi",
  "moonsage/agent",
  "moonsage/tools",
  "moonsage/audit",
  "moonsage/dotenv",
  "moonbitlang/async",
  "moonbitlang/async/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/sys",
}

options(
  "native-stub": [ "windows_argv.c", "console_utf8.c" ],
)
