# MoonSage configuration
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env   (or:  Copy-Item .env.example .env)
#
# `.env` is git-ignored and must never be committed.

# Required for the `ask` command.
MOONSAGE_API_KEY=your-api-key-here

# Optional overrides. The defaults below match the DeepSeek API.
MOONSAGE_BASE_URL=https://api.deepseek.com
MOONSAGE_MODEL=deepseek-chat
