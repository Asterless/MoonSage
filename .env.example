# MoonSage configuration
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env   (or:  Copy-Item .env.example .env)
#
# `.env` is git-ignored and must never be committed.

# Required and must be non-empty for `chat`, `ask`, and `audit`. Use a
# non-empty placeholder when connecting to an unauthenticated local Ollama.
MOONSAGE_API_KEY=your-api-key-here

# Optional overrides. The defaults below match the DeepSeek API.
MOONSAGE_BASE_URL=https://api.deepseek.com
MOONSAGE_MODEL=deepseek-chat

# Wire protocol: openai, anthropic, or ollama.
MOONSAGE_PROVIDER=openai

# Optional: one trusted stdio MCP server for `ask` as a JSON object.
# MOONSAGE_MCP={"name":"files","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","D:/work"],"timeout_ms":30000}
