///|
test "apply_edits_to_file replaces a single match" {
  let content = "pub fn a() {}\npub fn b() {}\n"
  let result = apply_edits_to_file(content, [
    {
      file: "x.mbt",
      old_string: "pub fn b() {}",
      new_string: "pub fn c() {}",
      start_line: 1,
      end_line: 0,
    },
  ])
  assert_eq(result, "pub fn a() {}\npub fn c() {}\n")
}

///|
test "apply_edits_to_file rejects no match" {
  let raised = try {
    ignore(
      apply_edits_to_file("abc\n", [
        {
          file: "x",
          old_string: "zzz",
          new_string: "y",
          start_line: 1,
          end_line: 0,
        },
      ]),
    )
    false
  } catch {
    _ => true
  }
  assert_true(raised)
}

///|
test "apply_edits_to_file rejects ambiguous match" {
  let raised = try {
    ignore(
      apply_edits_to_file("x y x\n", [
        {
          file: "x",
          old_string: "x",
          new_string: "z",
          start_line: 1,
          end_line: 0,
        },
      ]),
    )
    false
  } catch {
    _ => true
  }
  assert_true(raised)
}

///|
test "apply_edits_to_file anchors by line range" {
  let result = apply_edits_to_file("x\nx\n", [
    { file: "x", old_string: "x", new_string: "y", start_line: 2, end_line: 2 },
  ])
  assert_eq(result, "x\ny\n")
}

///|
test "apply_edits_to_file inserts at line start" {
  let result = apply_edits_to_file("a\nb\n", [
    {
      file: "x",
      old_string: "",
      new_string: "// note\n",
      start_line: 2,
      end_line: 0,
    },
  ])
  assert_eq(result, "a\n// note\nb\n")
}

///|
test "apply_edits_to_file appends past end of file" {
  let result = apply_edits_to_file("a\n", [
    {
      file: "x",
      old_string: "",
      new_string: "b\n",
      start_line: 99,
      end_line: 0,
    },
  ])
  assert_eq(result, "a\nb\n")
}

///|
test "apply_edits_to_file rejects overlapping edits" {
  let raised = try {
    ignore(
      apply_edits_to_file("abcdef\n", [
        {
          file: "x",
          old_string: "abc",
          new_string: "1",
          start_line: 1,
          end_line: 0,
        },
        {
          file: "x",
          old_string: "bcd",
          new_string: "2",
          start_line: 1,
          end_line: 0,
        },
      ]),
    )
    false
  } catch {
    _ => true
  }
  assert_true(raised)
}

///|
test "apply_edits_to_file applies multiple edits bottom-up" {
  let result = apply_edits_to_file("a\nb\nc\n", [
    { file: "x", old_string: "a", new_string: "A", start_line: 1, end_line: 0 },
    { file: "x", old_string: "c", new_string: "C", start_line: 3, end_line: 0 },
  ])
  assert_eq(result, "A\nb\nC\n")
}

///|
async test "multi_edit_tool applies edits atomically with syntax gate" {
  let tmp = @fs.tmpdir(prefix="moonsage-edit-test-")
  let _ = @fs.write_file(
    tmp + "/a.mbt",
    "pub fn old() {}\n",
    create_mode=@fs.CreateMode::CreateOrTruncate,
  )
  let ctx : AuditContext = { project_dir: tmp, fix: true, confirm: ConfirmDiff }
  let ok = multi_edit_tool(
    ctx, "{\"edits\":[{\"file\":\"a.mbt\",\"old_string\":\"pub fn old() {}\",\"new_string\":\"pub fn new() {}\",\"start_line\":1}]}",
  )
  assert_true(ok.contains("applied"))
  assert_true(@fs.read_file(tmp + "/a.mbt").text().contains("pub fn new()"))
  // 语法门拒绝：修改后无法解析，整批不落盘。
  let bad = try {
    ignore(
      multi_edit_tool(
        ctx, "{\"edits\":[{\"file\":\"a.mbt\",\"old_string\":\"pub fn new() {}\",\"new_string\":\"fn bad( {\",\"start_line\":1}]}",
      ),
    )
    false
  } catch {
    e => e.to_string().contains("语法检查")
  }
  assert_true(bad)
  assert_true(@fs.read_file(tmp + "/a.mbt").text().contains("pub fn new()"))
  remove_workspace_dir(tmp)
}

///|
async test "remove_tool deletes files within workspace only" {
  let tmp = @fs.tmpdir(prefix="moonsage-remove-test-")
  let _ = @fs.write_file(
    tmp + "/gone.mbt",
    "x",
    create_mode=@fs.CreateMode::CreateOrTruncate,
  )
  let ctx : AuditContext = { project_dir: tmp, fix: true, confirm: ConfirmDiff }
  let ok = remove_tool(ctx, "{\"path\":\"gone.mbt\"}")
  assert_eq(ok, "removed gone.mbt")
  let raised = try {
    ignore(remove_tool(ctx, "{\"path\":\"../outside\"}"))
    false
  } catch {
    _ => true
  }
  assert_true(raised)
  remove_workspace_dir(tmp)
}

///|
test "pr title branch and email builders" {
  assert_eq(
    pr_title("owner", "repo"),
    "fix: apply MoonSage audit fixes to owner/repo",
  )
  assert_eq(pr_branch_name("repo"), "moonsage/fix-repo")
  assert_eq(
    pr_commit_email("Asterless", 79297402),
    "79297402+Asterless@users.noreply.github.com",
  )
  assert_true(
    build_pr_body("报告", "o", "r").contains("Generated by MoonSage"),
  )
}
